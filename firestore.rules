rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socialLinks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{id} {
      allow read, write: if isAdmin();
    }
  }
}
